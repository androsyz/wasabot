WASABOT_ADDR=127.0.0.1:8080
WASABOT_DB_PATH=wasabot.db
WASABOT_LOG_LEVEL=info
WASABOT_LOG_FORMAT=json

# Any OpenAI-compatible chat completions API.
# OpenRouter: https://openrouter.ai/api/v1 (models like openai/gpt-4o-mini)
# Ollama:     http://localhost:11434/v1 (no API key needed)
WASABOT_LLM_BASE_URL=https://api.openai.com/v1
WASABOT_LLM_API_KEY=
WASABOT_LLM_MODEL=gpt-4o-mini

# Your own agent file. Empty uses the built-in agent. See docs/how-to/use-your-own-agent.md and examples/agent.md
# WASABOT_AGENT_FILE=/path/to/agent.md

# Safety limits
WASABOT_RATE_LIMIT=10
WASABOT_MAX_MESSAGE_AGE=10m
# WASABOT_FALLBACK_REPLY=Sorry, I could not answer that right now. Please try again in a moment.

# Set to true when a reverse proxy terminates TLS in front of the web UI
# WASABOT_COOKIE_SECURE=true

# First-run admin. By default wasabot creates admin/admin and makes you change it at first login.
# If the app is reachable by others, pick one of these instead (no default account is made):
# WASABOT_SETUP_CODE=choose-a-secret-code      (the first-run page asks for it)
# WASABOT_ADMIN_EMAIL=you@example.com          (or create the admin at startup)
# WASABOT_ADMIN_PASSWORD=at-least-12-characters
