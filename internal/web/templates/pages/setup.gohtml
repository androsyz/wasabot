{{define "page"}}{{template "authshell" .}}{{end}}

{{define "authbody"}}
<div class="card-wrap">
  <div class="mascot" aria-hidden="true"><span class="m-idle">{{sprite "mascot" "sprite-mascot"}}</span><span class="m-cover">{{sprite "mascot-cover" "sprite-mascot"}}</span></div>
  <section class="card frame frame-lg">
    <h1>Welcome to wasabot</h1>
    <p class="sub">Create the super admin account to get started.</p>
    {{if .Notice}}<div class="notice notice-bad" role="alert">{{.Notice}}</div>{{end}}
    <form method="post" action="/setup">
      <input type="hidden" name="csrf" value="{{.CSRF}}">
      <div><label class="sr-only" for="code">Setup code</label><input id="code" class="field frame" type="password" name="code" value="{{.SetupCode}}" placeholder="Setup code" autocomplete="off" required><p class="hint">Set on the server as WASABOT_SETUP_CODE, or use the link in its log.</p></div>
      <div><label class="sr-only" for="name">Name</label><input id="name" class="field frame" type="text" name="name" value="{{.Name}}" placeholder="Name" autocomplete="name" required></div>
      <div><label class="sr-only" for="email">Email</label><input id="email" class="field frame" type="email" name="email" value="{{.Email}}" placeholder="email" autocomplete="username" required></div>
      <div><label class="sr-only" for="password">Password</label><input id="password" class="field frame" type="password" name="password" placeholder="password" autocomplete="new-password" minlength="12" data-strength="meter" required></div>
      <div><label class="sr-only" for="confirm">Confirm password</label><input id="confirm" class="field frame" type="password" name="confirm" placeholder="confirm password" autocomplete="new-password" minlength="12" required></div>
      <div><div class="meter" id="meter" data-score="0"><i></i><i></i><i></i><i></i></div><p class="hint">min 12 characters</p></div>
      <button class="btn frame btn-block" type="submit">Create admin account</button>
    </form>
    <p class="fineprint">Step 1 of 2 (Create admin)</p>
  </section>
</div>
{{end}}
